# Cal.diy self-hosted — somente servidor. Gere os segredos reais na VPS; nunca commite o .env.
# Copie para .env e preencha. Para a senha do banco use: openssl rand -hex 32

# Domínio público do agendamento (sem barra no final).
NEXT_PUBLIC_WEBAPP_URL=https://agenda.argusprime.com.br

# Banco (Postgres do próprio compose). Use uma senha forte e única sem caracteres reservados em URL.
CALCOM_DB_PASSWORD=

# Cookies de sessão (NextAuth). openssl rand -base64 32
NEXTAUTH_SECRET=

# Chave de criptografia simétrica AES-256 — precisa ter 32 bytes. openssl rand -base64 24
CALENDSO_ENCRYPTION_KEY=

# Chave para credenciais do app store (ex.: conexão com Google/Outlook Calendar).
# openssl rand -base64 24
CALCOM_APP_CREDENTIAL_ENCRYPTION_KEY=

# ----- E-mail (obrigatório: o cal.diy exige SMTP para confirmar o 1º cadastro e enviar convites) -----
EMAIL_FROM=agenda@argusprime.com.br
EMAIL_FROM_NAME=Argus Prime
# Office 365 via SMTP AUTH (exige a caixa com SMTP AUTH habilitado no tenant):
EMAIL_SERVER_HOST=smtp.office365.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=agenda@argusprime.com.br
EMAIL_SERVER_PASSWORD=
