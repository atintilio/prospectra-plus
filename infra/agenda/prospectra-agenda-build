#!/usr/bin/env bash
# Compila o cal.diy nativo na VPS e registra cada etapa no log.
set -uo pipefail
exec >>/var/log/prospectra-agenda-build.log 2>&1

YARN=/usr/local/bin/yarn4
RUNENV=(python3 /opt/agenda/run_env.py)
export YARN_NM_MODE=hardlinks-local

fail() {
  echo "=== BUILD v6 FIM (falha) $(date -Is) ==="
  exit 1
}

step() {
  local name=$1 limit=$2 result
  shift 2
  echo "--- $name ---"
  timeout "$limit" "${RUNENV[@]}" "$YARN" "$@"
  result=$?
  echo "$name=$result"
  [ "$result" -eq 0 ] || fail
}

echo "=== BUILD v6 INICIADO $(date -Is) ==="
cd /opt/agenda/source || fail
step install 14400 install --immutable
[ -f node_modules/.yarn-state.yml ] || fail
step trpc 900 workspace @calcom/trpc run build
step embed 900 --cwd packages/embeds/embed-core workspace @calcom/embed-core run build
step assets 600 --cwd apps/web workspace @calcom/web run copy-app-store-static
step web 3600 --cwd apps/web workspace @calcom/web run build
step migrate 600 prisma migrate deploy --schema=packages/prisma/schema.prisma
chown -R prospectra-agenda:prospectra-agenda /opt/agenda/source || fail
echo "=== BUILD v6 FIM $(date -Is) ==="
