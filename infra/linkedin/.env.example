# Worker de LinkedIn (VPS). Uma instância por conta do LinkedIn.
# Segredos ficam SÓ na VPS — nunca no app/Vercel.
LINKEDIN_WORKER_KEY=   # mesmo valor de LINKEDIN_WORKER_KEY na Vercel (Bearer do /dispatch)
LI_AT=                 # cookie de sessão li_at da conta do LinkedIn
PROXY_URL=             # opcional: proxy residencial, ex. http://user:pass@host:porta (1 IP estável por conta)
PORT=8080              # escuta em 127.0.0.1; exponha via túnel/nginx com TLS p/ a Vercel alcançar
HEADLESS=true
