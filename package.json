{
  "name": "prospectra",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/migrate.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "build:voice-worker": "esbuild scripts/voice-worker.ts --bundle --platform=node --format=cjs --conditions=react-server --external:@electric-sql/* --outfile=.dist/voice-worker.cjs",
    "start:voice-worker": "node .dist/voice-worker.cjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.3.15",
    "@fontsource/libre-baskerville": "5.1.0",
    "drizzle-orm": "0.44.7",
    "geist": "1.3.1",
    "lucide-react": "0.468.0",
    "next": "16.3.6",
    "postgres": "3.4.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "@tailwindcss/postcss": "4.1.14",
    "@types/node": "22.10.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "drizzle-kit": "0.31.5",
    "tailwindcss": "4.1.14",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild"
    ]
  }
}
