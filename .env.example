# URL pública usada nos links de criação e recuperação de senha.
PUBLIC_APP_URL=https://prospectra.argusprime.com.br
MASTER_USER_EMAIL=atintilio@argusprime.com.br

# Autenticação server-side. Nunca exponha estas variáveis no navegador.
DATABASE_URL=
DATABASE_SSL=true
AUTH_SECRET=

# E-mail transacional compatível com Resend ou provedor REST equivalente.
EMAIL_API_BASE_URL=https://api.resend.com
EMAIL_API_KEY=
EMAIL_FROM=Prospectra+ <no-reply@argusprime.com.br>

# ScrapeGraphAI: chave enviada pelo backend no cabeçalho SGAI-APIKEY.
SGAI_BASE_URL=https://api.scrapegraphai.com
SGAI_API_KEY=
SGAI_SCRAPE_PATH=/v1/scrape
SGAI_HEALTH_PATH=/health

# CRM trycompai/crm ou gateway compatível. Nunca expor a chave no bundle web.
CRM_BASE_URL=
CRM_API_KEY=
CRM_HEALTH_PATH=/health
CRM_ACCOUNTS_PATH=/api/companies
CRM_CONTACTS_PATH=/api/contacts

# Canais não oficiais, mantidos server-side.
WHATSAPP_PROVIDER_BASE_URL=
WHATSAPP_PROVIDER_API_KEY=
WHATSAPP_WEBHOOK_SECRET=
LINKEDIN_PROVIDER_BASE_URL=
LINKEDIN_PROVIDER_API_KEY=
LINKEDIN_WEBHOOK_SECRET=
