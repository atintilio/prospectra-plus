# Nunca exponha esta variável no navegador. Configure-a pelo gerenciador seguro de segredos.
SGAI_API_KEY=

# WhatsApp via Evolution API, sempre no servidor/persistent worker.
WHATSAPP_PROVIDER_BASE_URL=
WHATSAPP_PROVIDER_API_KEY=
WHATSAPP_WEBHOOK_SECRET=

# LinkedIn via provedor de API não oficial configurável.
LINKEDIN_PROVIDER_BASE_URL=
LINKEDIN_PROVIDER_API_KEY=
LINKEDIN_WEBHOOK_SECRET=

# Banco gerenciado do Prospectra+ em produção (backend apenas).
DATABASE_URL=

# Chave de sessão da futura autenticação de operadores.
SESSION_SECRET=
