# URL pública do deployment, usada nos links de convite e recuperação.
PUBLIC_APP_URL=https://prospectra.argusprime.com.br
MASTER_USER_EMAIL=atintilio@argusprime.com.br
# Sessão assinada; armazenar somente no Vercel.
AUTH_SECRET=
# O Vercel Blob conecta BLOB_READ_WRITE_TOKEN automaticamente ao projeto.
BLOB_READ_WRITE_TOKEN=
# Microsoft Graph usando o App Registration/serviço Office 365 conectado.
# O serviço precisa de Mail.Send (Application) com admin consent.
OFFICE365_TENANT_ID=
OFFICE365_CLIENT_ID=
OFFICE365_CLIENT_SECRET=
OFFICE365_SENDER_EMAIL=atintilio@argusprime.com.br
# Compatibilidade com o serviço já funcional do Reversa; use estes nomes se preferir copiar a configuração existente.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_GRAPH_USER_ID=atintilio@argusprime.com.br
MAIL_FROM=atintilio@argusprime.com.br
# Integrações opcionais, sempre server-side.
# ScrapeGraphAI v2; a API key nunca vai para o frontend.
SGAI_BASE_URL=https://v2-api.scrapegraphai.com
SGAI_API_KEY=
CRM_BASE_URL=
CRM_API_KEY=
# Evolution API/WhatsApp: servidor persistente separado do Vercel.
# A chave deve ser a mesma AUTHENTICATION_API_KEY da Evolution, nunca exposta no frontend.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=prospectra-argusprime
EVOLUTION_WEBHOOK_SECRET=
EVOLUTION_WEBHOOK_URL=https://prospectra.argusprime.com.br/api/integrations/whatsapp/webhook
EVOLUTION_API_HEALTH_PATH=/
WHATSAPP_PROVIDER_BASE_URL=
WHATSAPP_PROVIDER_API_KEY=
WHATSAPP_PROVIDER_HEALTH_PATH=/
# LinkedIn: Abridge + linkout-scraper em Chrome local visível.
LINKEDIN_PROVIDER_BASE_URL=
LINKEDIN_PROVIDER_API_KEY=
LINKEDIN_PROVIDER_HEALTH_PATH=/health
# Conexão hospedada de contas (Unipile). As chaves ficam somente no Vercel.
# Requer assinatura do provedor; não configura automação de navegador no Prospectra.
UNIPILE_DSN=
UNIPILE_API_KEY=
UNIPILE_WEBHOOK_SECRET=
