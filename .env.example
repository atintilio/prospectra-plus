# Banco (Neon/Postgres). Em desenvolvimento local: pglite://./.data/dev
DATABASE_URL=
# Segredo para sessões (já existe na Vercel)
AUTH_SECRET=
# URL pública do app, sem barra no final
PUBLIC_APP_URL=https://prospectra.argusprime.com.br
# Primeiro administrador master
MASTER_USER_EMAIL=atintilio@argusprime.com.br
# Office 365 (Microsoft Graph, permissão Mail.Send de aplicativo)
OFFICE365_TENANT_ID=
OFFICE365_CLIENT_ID=
OFFICE365_CLIENT_SECRET=
OFFICE365_SENDER_EMAIL=
# IA (OpenRouter). Modelo principal Qwen, com fallback gratuito
OPENROUTER_API_KEY=
AI_MODEL=qwen/qwen3-30b-a3b:free
# WhatsApp WA-AKG (somente servidor; aceita prefixo do proxy, sem /api final)
WA_AKG_BASE_URL=
WA_AKG_API_KEY=
