{
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/demo",
      "destination": "/index.html"
    },
    {
      "source": "/demo/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/recuperar-senha",
      "destination": "/index.html"
    },
    {
      "source": "/definir-senha",
      "destination": "/index.html"
    },
    {
      "source": "/crm",
      "destination": "/index.html"
    },
    {
      "source": "/enriquecimento",
      "destination": "/index.html"
    },
    {
      "source": "/automacao",
      "destination": "/index.html"
    },
    {
      "source": "/campanhas",
      "destination": "/index.html"
    },
    {
      "source": "/operacoes",
      "destination": "/index.html"
    },
    {
      "source": "/equipes",
      "destination": "/index.html"
    },
    {
      "source": "/owner",
      "destination": "/index.html"
    },
    {
      "source": "/configuracoes",
      "destination": "/index.html"
    }
  ]
}
